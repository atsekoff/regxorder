import { HorizontalBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";

export component EventFilterButton inherits Rectangle {
    in property <image> icon;
    in property <string> count_label: "0";
    in property <bool> checked: false;
    in property <bool> enabled: true;
    in property <string> control_accessible_label: "";
    callback toggled(checked: bool);

    accessible-role: checkbox;
    accessible-label: root.control_accessible_label;
    accessible-enabled: root.enabled;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-value: root.count_label;
    accessible-action-default => {
        if root.enabled {
            root.toggled(!root.checked);
        }
    }

    height: 28px;
    preferred-width: count_text.preferred-width + 40px;
    border-radius: 14px;
    border-width: 1px;
    border-color: !root.enabled ? Theme.panel-border : root.checked ? Theme.accent-soft-border : Theme.panel-border;
    background: !root.enabled ? #eef2f5 : root.checked ? Theme.accent-soft : Theme.panel-background;

    HorizontalBox {
        width: parent.width;
        height: parent.height;
        padding-left: 9px;
        padding-right: 10px;
        padding-top: 7px;
        padding-bottom: 7px;
        spacing: 7px;

        Image {
            width: 14px;
            height: 14px;
            source: root.icon;
            opacity: root.enabled ? 1 : 0.45;
        }

        count_text := Text {
            height: 14px;
            vertical-alignment: center;
            text: root.count_label;
            color: !root.enabled ? #8b847a : root.checked ? Theme.text-strong : Theme.text-subtle;
            font-size: 12px;
        }
    }

    TouchArea {
        enabled: root.enabled;
        clicked => {
            root.toggled(!root.checked);
        }
    }
}
