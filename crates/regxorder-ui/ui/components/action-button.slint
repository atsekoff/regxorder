import { Theme } from "../theme.slint";

export component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <length> label_font_size: 13px;
    in property <length> button_height: 32px;
    callback tapped();

    height: root.button_height;
    border-radius: Theme.control-radius;
    border-width: 1px;
    border-color: !root.enabled ? Theme.divider : root.danger ? Theme.danger-border : root.selected || root.primary ? Theme.accent-soft-border : Theme.divider;
    background: !root.enabled ? Theme.surface-muted : root.danger ? Theme.danger-soft : root.selected ? Theme.accent-soft : root.primary ? Theme.surface-muted : transparent;

    Text {
        x: 10px;
        y: (parent.height - self.height) / 2;
        width: parent.width - 20px;
        text: root.label;
        horizontal-alignment: center;
        color: !root.enabled ? #7d8994 : root.danger ? Theme.danger : Theme.accent;
        font-size: root.label_font_size;
    }

    TouchArea {
        enabled: root.enabled;
        clicked => {
            root.tapped();
        }
    }
}
