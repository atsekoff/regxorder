import { Button, HorizontalBox } from "std-widgets.slint";

export component EventRow inherits Rectangle {
    in property <string> index_label;
    in property <string> type_label;
    in property <string> parameter_label;
    in property <string> duration_label;
    in property <bool> delete_enabled: true;
    callback delete_requested();

    property <bool> placeholder: root.index_label == "";
    property <length> index_column_width: 42px;
    property <length> type_column_width: 110px;
    property <length> duration_column_width: 92px;
    property <length> action_column_width: 72px;

    height: 40px;

    HorizontalBox {
        padding: 6px;
        spacing: 10px;

        Rectangle {
            width: root.index_column_width;
            height: 20px;
            background: transparent;

            Text {
                y: (parent.height - self.height) / 2;
                width: parent.width;
                text: root.index_label;
            }
        }

        Rectangle {
            width: root.type_column_width;
            height: 20px;
            background: transparent;

            Text {
                y: (parent.height - self.height) / 2;
                width: parent.width;
                text: root.type_label;
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            height: 20px;
            background: transparent;
            clip: true;

            Text {
                y: (parent.height - self.height) / 2;
                width: parent.width;
                text: root.parameter_label;
            }
        }

        Rectangle {
            width: root.duration_column_width;
            height: 20px;
            background: transparent;

            Text {
                y: (parent.height - self.height) / 2;
                width: parent.width;
                text: root.duration_label;
            }
        }

        if root.delete_enabled && !root.placeholder: Button {
            width: root.action_column_width;
            text: "Delete";
            enabled: root.delete_enabled;
            clicked => {
                root.delete_requested();
            }
        }

        if !root.delete_enabled || root.placeholder: Rectangle {
            width: root.action_column_width;
            background: transparent;
        }
    }
}
