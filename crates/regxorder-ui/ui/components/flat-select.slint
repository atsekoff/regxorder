import { ComboBox, HorizontalBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";

export component FlatSelect inherits Rectangle {
    in property <[string]> model: [];
    in property <int> selected_index: -1;
    in property <string> selected_label: "";
    in property <bool> enabled: true;
    in property <string> control_accessible_label: "";
    callback selection_requested(index: int);

    forward-focus: combo_box;

    height: 32px;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.divider;
    background: root.enabled ? Theme.surface : Theme.surface-muted;

    HorizontalBox {
        width: parent.width;
        height: parent.height;
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;

        Rectangle {
            horizontal-stretch: 1;
            background: transparent;

            Text {
                width: parent.width;
                height: parent.height;
                text: root.selected_label == "" ? "No sessions" : root.selected_label;
                vertical-alignment: center;
                color: root.enabled ? Theme.text-strong : Theme.text-muted;
                font-size: 12px;
            }
        }

        Rectangle {
            width: 10px;
            height: parent.height;
            background: transparent;
        }
    }

    combo_box := ComboBox {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        opacity: 0.01;
        model: root.model;
        current-index: root.selected_index < 0 ? 0 : root.selected_index;
        current-value: root.selected_label;
        accessible-label: root.control_accessible_label;
        accessible-value: root.selected_label == "" ? "No sessions" : root.selected_label;
        selected(_) => {
            if self.current-index >= 0 {
                root.selection_requested(self.current-index);
            }
        }
    }
}
