import { HorizontalBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";

export component NavButton inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    callback tapped();

    height: 36px;
    border-radius: 12px;
    background: root.selected ? Theme.accent-soft : Theme.panel-background;

    HorizontalBox {
        width: parent.width;
        height: parent.height;
        padding-left: 14px;
        padding-right: 14px;

        Rectangle {
            horizontal-stretch: 1;
            background: transparent;

            Text {
                width: parent.width;
                height: parent.height;
                text: root.label;
                vertical-alignment: center;
                color: root.selected ? Theme.accent : #556474;
                font-size: 14px;
            }
        }
    }

    TouchArea {
        clicked => {
            root.tapped();
        }
    }
}
