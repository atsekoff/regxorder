export global Theme {
    in property <color> window-background: #f7fbfd;
    in property <color> header-background: #fcfeff;
    in property <color> nav-background: #f3f8fb;
    in property <color> content-background: #ffffff;
    in property <color> surface: #ffffff;
    in property <color> surface-muted: #eef4f7;
    in property <color> panel-background: #fcfdff;
    in property <color> panel-background-muted: #f4f8fb;
    in property <color> panel-border: #d5dee7;
    in property <color> divider: #d8e3ea;
    in property <color> accent: #0e6177;
    in property <color> accent-strong: #0a4d60;
    in property <color> accent-soft: #dff1f7;
    in property <color> accent-soft-border: #bcdbe6;
    in property <color> success-soft: #e3f4e7;
    in property <color> success-border: #bddfc6;
    in property <color> danger: #b34b37;
    in property <color> danger-soft: #fbede8;
    in property <color> danger-border: #ebc3b9;
    in property <color> text-strong: #173042;
    in property <color> text-muted: #617181;
    in property <color> text-subtle: #46586a;
    in property <color> warning-background: #fff3e4;
    in property <color> warning-border: #e8c9a5;
    in property <color> warning-text: #8a4b08;
    in property <color> success-text: #1d513c;
    in property <length> shell-padding: 0px;
    in property <length> panel-radius: 0px;
    in property <length> control-radius: 8px;
    in property <length> event-index-column-width: 38px;
    in property <length> event-type-column-width: 108px;
    in property <length> event-duration-column-width: 88px;
    in property <length> event-delete-column-width: 24px;
}
