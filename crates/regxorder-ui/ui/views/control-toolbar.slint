import { Button, HorizontalBox, LineEdit, VerticalBox } from "std-widgets.slint";

component CommitLineEdit inherits LineEdit {
    in property <bool> allow_decimal: false;
    in property <string> field_accessible_label: "";
    callback value_edited(value: string);
    callback value_committed(value: string);

    private property <bool> commit_on_focus_loss: true;

    accessible-label: root.field_accessible_label;
    horizontal-alignment: center;
    input-type: root.allow_decimal ? decimal : number;

    edited => {
        root.value_edited(self.text);
    }

    accepted => {
        self.commit_on_focus_loss = false;
        root.value_committed(self.text);
        self.clear-focus();
    }

    changed has-focus => {
        if self.has-focus {
            self.commit_on_focus_loss = true;
        } else if self.commit_on_focus_loss {
            root.value_committed(self.text);
        } else {
            self.commit_on_focus_loss = true;
        }
    }

    public function commit_pending() {
        if self.has-focus {
            self.commit_on_focus_loss = false;
            root.value_committed(self.text);
            self.clear-focus();
        }
    }
}

export component ControlToolbar inherits Rectangle {

    public function commit_and_blur_toolbar_inputs() {
        loop_control.commit_pending();
        speed_control.commit_pending();
    }

    in property <string> toolbar_status_label;
    in property <string> toolbar_file_label;
    in property <string> toolbar_detail_label;
    in property <bool> can_start_recording: true;
    in property <bool> can_stop_active_action: false;
    in property <bool> can_play_selected_recording: false;
    in property <bool> playback_is_running: false;
    in property <string> playback_loop_input_text: "1";
    in property <string> playback_speed_input_text: "1.0";
    in property <string> playback_speed_validation_message: "";
    callback start_recording_requested();
    callback stop_active_action_requested();
    callback play_selected_recording_requested();
    callback playback_loop_input_edited(value: string);
    callback playback_loop_input_committed(value: string);
    callback playback_speed_input_edited(value: string);
    callback playback_speed_input_committed(value: string);

    VerticalBox {
        width: parent.width;
        padding: 12px;
        spacing: 10px;

        Text {
            text: root.toolbar_status_label;
            wrap: word-wrap;
        }

        Text {
            text: root.toolbar_file_label;
            wrap: word-wrap;
        }

        Text {
            text: root.toolbar_detail_label;
            wrap: word-wrap;
        }

        HorizontalBox {
            spacing: 8px;

            record_button := Button {
                icon: @image-url("../../assets/icons/RecordIcon_fill.svg");
                colorize-icon: true;
                accessible-label: "Start recording";
                width: 40px;
                height: 40px;
                enabled: root.can_start_recording;
                clicked => {
                    root.commit_and_blur_toolbar_inputs();
                    root.start_recording_requested();
                }
            }

            stop_button := Button {
                icon: @image-url("../../assets/icons/StopIcon_fill.svg");
                colorize-icon: true;
                accessible-label: "Stop active action";
                width: 40px;
                height: 40px;
                enabled: root.can_stop_active_action;
                clicked => {
                    root.commit_and_blur_toolbar_inputs();
                    root.stop_active_action_requested();
                }
            }

            play_button := Button {
                icon: @image-url("../../assets/icons/PlayIcon_fill.svg");
                colorize-icon: true;
                accessible-label: "Play selected session";
                width: 40px;
                height: 40px;
                enabled: root.can_play_selected_recording;
                clicked => {
                    root.commit_and_blur_toolbar_inputs();
                    root.play_selected_recording_requested();
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                background: transparent;
            }

            Text {
                vertical-alignment: center;
                text: "Loops";
            }

            loop_control := CommitLineEdit {
                width: 96px;
                text: root.playback_loop_input_text;
                field_accessible_label: "Playback loops";
                enabled: !root.can_stop_active_action;
                value_edited(value) => {
                    root.playback_loop_input_edited(value);
                }
                value_committed(value) => {
                    root.playback_loop_input_committed(value);
                }
            }

            Text {
                vertical-alignment: center;
                text: "Speed";
            }

            speed_control := CommitLineEdit {
                width: 96px;
                text: root.playback_speed_input_text;
                field_accessible_label: "Playback speed";
                enabled: !root.can_stop_active_action;
                allow_decimal: true;
                value_edited(value) => {
                    root.playback_speed_input_edited(value);
                }
                value_committed(value) => {
                    root.playback_speed_input_committed(value);
                }
            }
        }

        if root.playback_speed_validation_message != "": Text {
            text: root.playback_speed_validation_message;
            wrap: word-wrap;
        }
    }
}
