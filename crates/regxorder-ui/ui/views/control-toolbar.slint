import {
    ControlBarStyle,
    ControlButtonStyle,
    ControlInputStyle,
} from "control-toolbar.style.slint";
import { HorizontalBox, VerticalBox } from "std-widgets.slint";
import { SquareIconButton } from "../components/square-icon-button.slint";
import { ToolbarValueControl } from "../components/toolbar-value-control.slint";

export component ControlToolbar inherits Rectangle {

    public function commit_and_blur_toolbar_inputs() {
        loop_control.commit_pending();
        speed_control.commit_pending();
    }

    in property <bool> can_start_recording: true;
    in property <bool> can_stop_active_action: false;
    in property <bool> can_play_selected_recording: false;
    in property <string> playback_loop_input_text: "1";
    in property <string> playback_speed_input_text: "1.0";
    callback start_recording_requested();
    callback stop_active_action_requested();
    callback play_selected_recording_requested();
    callback playback_loop_input_edited(value: string);
    callback playback_loop_input_committed(value: string);
    callback playback_speed_input_edited(value: string);
    callback playback_speed_input_committed(value: string);

    clip: true;
    height: ControlBarStyle.control_row_height;

    GridLayout {
        spacing: 0px;
        padding: 0px;

        col_0_spacer := Rectangle {
            width: parent.width / 3;
        }

        control_buttons_container := VerticalLayout {
            alignment: center;
            width: parent.width / 3;
            HorizontalLayout {
                alignment: center;
                padding: 0px;
                spacing: ControlButtonStyle.control_button_spacing;
                record_button := SquareIconButton {
                    icon: @image-url("../../assets/icons/RecordIcon_fill.svg");
                    icon_color: ControlButtonStyle.record_button_color;
                    size: ControlButtonStyle.control_button_size;
                    enabled: root.can_start_recording;
                    clicked => {
                        root.commit_and_blur_toolbar_inputs();
                        root.start_recording_requested();
                    }
                }

                stop_button := SquareIconButton {
                    icon: @image-url("../../assets/icons/StopIcon_fill.svg");
                    icon_color: ControlButtonStyle.stop_button_color;
                    size: ControlButtonStyle.control_button_size;
                    enabled: root.can_stop_active_action;
                    clicked => {
                        root.commit_and_blur_toolbar_inputs();
                        root.stop_active_action_requested();
                    }
                }

                play_button := SquareIconButton {
                    icon: @image-url("../../assets/icons/PlayIcon_fill.svg");
                    icon_color: ControlButtonStyle.play_button_color;
                    size: ControlButtonStyle.control_button_size;
                    enabled: root.can_play_selected_recording;
                    clicked => {
                        root.commit_and_blur_toolbar_inputs();
                        root.play_selected_recording_requested();
                    }
                }
            }
        }

        control_inputs_container := VerticalLayout {
            alignment: center;
            width: parent.width / 3;

            HorizontalLayout {
                alignment: end;
                padding: 0px;
                padding-right: ControlInputStyle.input_spacing;
                spacing: ControlInputStyle.input_spacing;

                loop_control := ToolbarValueControl {
                    icon: @image-url("../../assets/icons/LoopIcon.svg");
                    icon_size: ControlInputStyle.input_icon_size;
                    field_width: ControlInputStyle.input_field_width;
                    field_height: ControlInputStyle.input_field_height;
                    text: root.playback_loop_input_text;
                    enabled: !root.can_stop_active_action;
                    value_edited(value) => {
                        root.playback_loop_input_edited(value);
                    }
                    value_committed(value) => {
                        root.playback_loop_input_committed(value);
                    }
                }

                speed_control := ToolbarValueControl {
                    icon: @image-url("../../assets/icons/ChronometerSpeedIcon.svg");
                    icon_size: ControlInputStyle.input_icon_size;
                    field_width: ControlInputStyle.input_field_width;
                    field_height: ControlInputStyle.input_field_height;
                    text: root.playback_speed_input_text;
                    enabled: !root.can_stop_active_action;
                    allow_decimal: true;
                    value_edited(value) => {
                        root.playback_speed_input_edited(value);
                    }
                    value_committed(value) => {
                        root.playback_speed_input_committed(value);
                    }
                }
            }
        }
    }
}
