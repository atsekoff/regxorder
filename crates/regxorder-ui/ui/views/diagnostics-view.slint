import { Button, HorizontalBox, ScrollView, VerticalBox } from "std-widgets.slint";

export component DiagnosticsView inherits Rectangle {
    in property <string> diagnostics_summary;
    in property <string> diagnostics_checks;
    in property <string> selected_recording_title;
    in property <string> selected_recording_details;
    in property <string> playback_summary;
    in property <string> playback_checks;
    callback refresh_diagnostics_requested();

    VerticalBox {
        padding: 4px;
        spacing: 12px;

        HorizontalBox {
            spacing: 8px;

            Text {
                text: "Diagnostics";
            }

            Rectangle {
                horizontal-stretch: 1;
                background: transparent;
            }

            Button {
                text: "Refresh";
                icon: @image-url("../../assets/icons/RefreshIcon.svg");
                colorize-icon: true;
                primary: true;
                clicked => {
                    root.refresh_diagnostics_requested();
                }
            }
        }

        Text {
            text: root.diagnostics_summary;
            wrap: word-wrap;
        }

        ScrollView {
            VerticalBox {
                spacing: 12px;

                Text {
                    text: root.selected_recording_title;
                    wrap: word-wrap;
                }

                Text {
                    text: root.selected_recording_details;
                    wrap: word-wrap;
                }

                Text {
                    text: root.playback_summary + "\n" + root.playback_checks;
                    wrap: word-wrap;
                }

                Text {
                    text: "Issues";
                }

                Text {
                    text: root.diagnostics_checks;
                    wrap: word-wrap;
                }
            }
        }
    }
}
