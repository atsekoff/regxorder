import { IconButton } from "../components/icon-button.slint";
import { Theme } from "../theme.slint";

export component ShellToolbar inherits Rectangle {
    in property <string> toolbar_status_label;
    in property <string> toolbar_file_label;
    in property <string> toolbar_detail_label;
    in property <bool> can_start_recording: true;
    in property <bool> can_stop_active_action: false;
    in property <bool> can_play_selected_recording: false;
    in property <bool> playback_is_running: false;
    in property <string> playback_speed_input_text: "1.0";
    in property <string> playback_speed_validation_message: "";
    callback start_recording_requested();
    callback stop_active_action_requested();
    callback play_selected_recording_requested();
    callback playback_speed_input_edited(value: string);
    callback playback_speed_input_committed(value: string);

    height: 48px;
    background: Theme.header-background;

    status_area := Rectangle {
        x: 12px;
        y: (parent.height - self.height) / 2;
        width: 150px;
        height: 32px;
        background: transparent;

        Text {
            y: (parent.height - self.height) / 2;
            width: parent.width;
            text: root.toolbar_status_label;
            color: Theme.text-strong;
            font-size: 14px;
        }
    }

    transport_controls := Rectangle {
        width: 116px;
        height: 34px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: transparent;

        IconButton {
            x: 0px;
            y: 1px;
            icon: @image-url("../../assets/icons/RecordIcon_fill.svg");
            control_accessible_label: "Start recording";
            button_width: 32px;
            button_height: 32px;
            danger: root.can_start_recording;
            enabled: root.can_start_recording;
            tapped => {
                root.commit_and_blur_playback_speed_input();
                root.start_recording_requested();
            }
        }

        IconButton {
            x: 42px;
            y: 1px;
            icon: @image-url("../../assets/icons/StopIcon_fill.svg");
            control_accessible_label: "Stop active action";
            button_width: 32px;
            button_height: 32px;
            selected: root.can_stop_active_action;
            enabled: root.can_stop_active_action;
            tapped => {
                root.commit_and_blur_playback_speed_input();
                root.stop_active_action_requested();
            }
        }

        IconButton {
            x: 84px;
            y: 1px;
            icon: @image-url("../../assets/icons/PlayIcon_fill.svg");
            control_accessible_label: "Play selected session";
            button_width: 32px;
            button_height: 32px;
            success: !root.can_stop_active_action && root.can_play_selected_recording;
            enabled: root.can_play_selected_recording;
            tapped => {
                root.commit_and_blur_playback_speed_input();
                root.play_selected_recording_requested();
            }
        }
    }

    speed_controls := Rectangle {
        width: 62px;
        height: 32px;
        x: parent.width - self.width - 12px;
        y: (parent.height - self.height) / 2;
        background: transparent;

        Image {
            x: 2px;
            y: (parent.height - self.height) / 2;
            width: 18px;
            height: 18px;
            source: @image-url("../../assets/icons/ChronometerSpeedIcon.svg");
            opacity: 0.65;
        }

        speed_input_shell := Rectangle {
            x: parent.width - self.width;
            width: 38px;
            height: 32px;
            border-width: 1px;
            border-radius: Theme.control-radius;
            border-color: speed_input.has-focus ? Theme.accent-soft-border : Theme.divider;
            background: root.can_stop_active_action ? Theme.surface-muted : Theme.surface;

            TouchArea {
                enabled: !root.can_stop_active_action;
                clicked => {
                    speed_input.text = root.playback_speed_input_text;
                    speed_input.focus();
                    speed_input.select-all();
                }
            }

            Text {
                y: (parent.height - self.height) / 2;
                width: parent.width;
                visible: !speed_input.has-focus;
                text: root.playback_speed_input_text;
                horizontal-alignment: center;
                color: root.can_stop_active_action ? Theme.text-muted : Theme.text-strong;
                font-size: 12px;
            }

            speed_input := TextInput {
                y: 0px;
                width: parent.width;
                height: parent.height;
                visible: self.has-focus;
                text: root.playback_speed_input_text;
                accessible-label: "Playback speed";
                color: Theme.text-strong;
                font-size: 12px;
                input-type: decimal;
                horizontal-alignment: center;
                vertical-alignment: center;
                read-only: root.can_stop_active_action;
                selection-background-color: Theme.accent-soft;
                selection-foreground-color: Theme.text-strong;
                private property <bool> commit_on_focus_loss: true;

                edited => {
                    root.playback_speed_input_edited(self.text);
                }

                accepted => {
                    self.commit_on_focus_loss = false;
                    root.playback_speed_input_committed(self.text);
                    self.clear-focus();
                }

                changed has-focus => {
                    if self.has-focus {
                        self.commit_on_focus_loss = true;
                    } else if self.commit_on_focus_loss {
                        root.playback_speed_input_committed(self.text);
                    } else {
                        self.commit_on_focus_loss = true;
                    }
                }
            }
        }
    }

    public function commit_and_blur_playback_speed_input() {
        if speed_input.has-focus {
            speed_input.commit_on_focus_loss = false;
            root.playback_speed_input_committed(speed_input.text);
            speed_input.clear-focus();
        }
    }

    Rectangle {
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.divider;
    }
}
